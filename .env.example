# Copy to .env for local runs. In CI these come from GitHub Actions secrets.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=D0XXXXXXXXX
SEC_USER_AGENT=Decade Partners Research glenn@decadepartners.com.au
# Optional: synced OneDrive/SharePoint folder to archive the PDF into.
SHAREPOINT_DEST=
# Biweekly parity: 0 = run on even ISO weeks, 1 = odd. Pick to land the first
# run on the fortnight you want.
BIWEEKLY_PARITY=0
